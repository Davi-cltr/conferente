# Copie este arquivo para ".env" e preencha.

# Chave de acesso do Mercado Pago (Suas integrações → sua aplicação → Credenciais de teste).
# Deixe vazio para usar o modo simulado, que não cobra nada.
MP_ACCESS_TOKEN=

# Endereço onde o sistema roda. No seu computador, deixe como está.
BASE_URL=http://127.0.0.1:8000

# Dias de teste grátis para contas novas.
DIAS_TESTE=14
